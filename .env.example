# Zelyo Config Guardian - Environment Configuration

# =============================================================================
# LLM PROVIDER CONFIGURATION
# =============================================================================

# Choose provider: openai, gemini, or openrouter
LLM_PROVIDER=openrouter

# OpenAI (if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter (if LLM_PROVIDER=openrouter) - Recommended for flexibility
OPENROUTER_API_KEY=sk-or-your-openrouter-key
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_REFERER=https://zelyo.io

# =============================================================================
# GITHUB INTEGRATION
# =============================================================================

# GitHub Personal Access Token with repo scope
GITHUB_TOKEN=ghp_your-github-token

# Target repository for PRs (format: org/repo)
GITHUB_REPO=your-org/your-gitops-repo

# Base branch for PRs (default: main)
GITHUB_BASE_BRANCH=main

# =============================================================================
# MCP SERVER
# =============================================================================

# Kubescape MCP Adapter URL
MCP_SERVER_URL=http://localhost:8090/sse
